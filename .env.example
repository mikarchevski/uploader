# .env.example
# Скопируйте этот файл в .env и заполните значения

# Секретный ключ для Flask (обязательно!)
# Сгенерируйте случайную строку: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="sekret-key"

# Пути к данным (опционально, по умолчанию используются пути внутри проекта)
UPLOAD_FOLDER=/opt/filebrowser/data/uploads
DB_PATH=/opt/filebrowser/data/uploads.db

# Настройки сервера
FLASK_ENV=production
FLASK_DEBUG=0